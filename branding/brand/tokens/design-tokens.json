  "spacing": {
    "base_unit_px": 4,
    "scale": {
      "xs": 4,
      "sm": 8,
      "md": 12,
      "lg": 16,
      "xl": 24,
      "xxl": 32,
      "xxxl": 48,
      "huge": 64
    },
    "rules": {
      "panel_padding": 24,
      "card_padding": 18,
      "group_gap": 12,
      "section_gap": 32,
      "hairline": 1,
      "brass_rule": 5,
      "min_hit_target": 44,
      "min_icon_box": 20,
      "grid_column": 8
    }
  },
  "type": {
    "families": {
      "display": "Saira Condensed",
      "ui": "Saira",
      "data": "JetBrains Mono",
      "cyrillic_display": "PT Sans Narrow",
      "cyrillic_ui": "PT Sans"
    },
    "sizes_at_1080p": {
      "display_l": 44,
      "display_m": 32,
      "display_s": 24,
      "body": 18,
      "button": 16,
      "label_mono": 14,
      "data_mono": 17,
      "micro_mono": 12
    },
    "weights": {
      "display": 700,
      "ui_regular": 400,
      "ui_medium": 500,
      "ui_semibold": 600,
      "data": 400,
      "data_bold": 700
    },
    "rules": [
      "data always mono, never bold",
      "display is uppercase, tracked 0.01-0.06em",
      "never below 24px for display, 18px for body",
      "micro_mono 12px only for dense chart labels"
    ]
  },
  "motion": {
    "durations_ms": {
      "micro": 90,
      "control": 160,
      "panel": 240,
      "screen": 320,
      "chart_pan": 320
    },
    "easing": {
      "enter": "cubic-bezier(0.2, 0, 0, 1)",
      "exit": "cubic-bezier(0.4, 0, 1, 1)",
      "data_tick": "linear"
    },
    "rules": [
      "no bounce, no overshoot, no spring",
      "entering elements translate max 8px, never scale",
      "numbers tick linearly, never ease",
      "one animation per interaction",
      "reduced-motion setting = instant, no fades"
    ]
  },
  "shapes": {
    "ruled_panel": "square + border-top 5px BRASS",
    "prow": "polygon(0 0, 76% 0, 100% 50%, 76% 100%, 0 100%)",
    "batter": "polygon(0 0, 100% 0, 88% 100%, 0 100%)",
    "pennant": "polygon(0 0, 100% 0, 82% 50%, 100% 100%, 0 100%)",
    "sounding_zone": "irregular dashed polygon, 6-8 points",
    "wedge": "triangle, heading marks only",
    "rules": [
      "no chamfered corners",
      "no rounded corners",
      "one shape per component",
      "circles only for dials, logo ring, buoys"
    ]
  }
}