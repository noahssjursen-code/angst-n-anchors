func choose(id: String) -> void:
	if not catalog.has(id): return
	_leave_cladding_paint()
	_cancel_move()
	selected=id
	library.set_selected(id)
	ghost_key=""
	build()

func _select_cladding_paint(colour: Color) -> void:
	_cancel_move()
	if editor!=null:editor.end_edit()
	painting=false
	cladding_paint_mode=true
	cladding_paint_colour=colour
	_painted_cladding.clear()
	_clear_build_target()
	feedback.text="Choose a colour · Tab to aim · hold LMB to paint cladding"

func _leave_cladding_paint() -> void:
	if not cladding_paint_mode:return
	if editor!=null:editor.end_edit()
	painting=false
	cladding_paint_mode=false
	_painted_cladding.clear()
	library.set_paint_active(false)
	_clear_build_target()

func _paint_cladding_target() -> void:
	if hovered_id.is_empty() or _painted_cladding.has(hovered_id) or not _construction_ready():return
	_painted_cladding[hovered_id]=true
	var result: Dictionary=editor.paint_cladding(hovered_id,cladding_paint_colour)
	if result.ok:
		_on_state_changed(state.to_dict(),result)
		feedback.text="Cladding painted · Ctrl+Z to undo this stroke"
	elif str(result.code)!="colour_unchanged":
		var errors: Array=result.get("errors",[])
		feedback.text=str(errors[0]) if not errors.is_empty() else str(result.code)

func _set_cursor(enabled: bool) -> void:
	cursor_mode=enabled
	if not enabled:
		var focus:=get_viewport().gui_get_focus_owner()
		if focus!=null: focus.release_focus()
	camera.set_flying(building and not enabled)
	if is_instance_valid(build_aim):build_aim.visible=building and not enabled
	if not building: _pause_player(enabled)
	Input.mouse_mode=Input.MOUSE_MODE_VISIBLE if enabled else Input.MOUSE_MODE_CAPTURED
	if enabled and editor!=null: editor.call("end_edit")
	if enabled: _clear_build_target()
	painting=false

func _pause_player(paused: bool) -> void:
	paused=paused or _ground_pause
	if is_instance_valid(vessel_session):vessel_session.set_input_blocked(paused)
	player.set_process(not paused)
	player.set_physics_process(not paused and not player.is_vehicle_occupied())
	player.set_process_unhandled_input(not paused and not player.is_vehicle_occupied())
	player.velocity=Vector3.ZERO

func build() -> void:
	if is_instance_valid(vessel_session) and not vessel_session.leave_helm():return
	_leave_cladding_paint()
	_cancel_move()
	_cancel_walk_transition()
	choosing_site=false
	building=true
	if is_instance_valid(inspector): inspector.hide()
	if is_instance_valid(map): map.hide()
	_clear_build_target()
	_pause_player(true)
	camera.current=true
	library.show(); overlays.show()
	hotbar.preview_inventory.selected_slot=0; hotbar.refresh()
	_set_cursor(false)

func walk() -> void:
	if survey_busy: return
	if is_instance_valid(vessel_session) and not vessel_session.leave_helm():return
	_cancel_move()
	_walk_when_ground_ready=false
	if _site_needs_home or (_home_dirty and not _player_ground_is_safe()):
		var home:=_find_home()
		if not home.ok:
			feedback.text="Build a foundation before walking on this plot."
			return
		home_local=home.local
		player.global_position=site+home_local
		player.velocity=Vector3.ZERO
		player.reset_physics_interpolation()
	painting=false
	if editor!=null: editor.end_edit()
	_sync_earthworks()
	if is_instance_valid(terrain) and (not terrain.is_custom_port_earthworks_ready() or not terrain.is_ready_around(player.global_position,35)):
		_walk_when_ground_ready=true
		_ground_pause=true
		_pause_player(true)
		_clear_build_target()
		camera.set_flying(false)
		_pin_walk_terrain()
		feedback.text="Preparing the ground for walking…"
		return
	building=false
	_ground_pause=false
	_site_needs_home=false
	_home_dirty=false
	map.hide()
	_set_cursor(false)
	camera.set_flying(false)
	library.hide(); overlays.hide(); inspector.hide()
	if is_instance_valid(ghost): ghost.hide()
	_pause_player(false)
	player.camera.current=true
	_release_walk_terrain()
	player.get_node("PlayerCamera")._update_body_visibility()
	hotbar.preview_inventory.selected_slot=-1; hotbar.refresh()
	feedback.text="WASD · Walk   F · Talk   1 · Build tool   H · Home   M · Plots"

func _pin_walk_terrain() -> void:
	if not is_instance_valid(terrain):return
	# Freecam may have left the player's chunk outside the visual request ring.
	# Request that destination before waiting for its current terrain collider.
	if not _walk_terrain_pinned or not terrain.is_boot_priority() or terrain.boot_focus()!=player.global_position:
		_walk_terrain_pinned=true
		terrain.begin_boot_priority(player.global_position)

func _release_walk_terrain() -> void:
	if not _walk_terrain_pinned:return
	_walk_terrain_pinned=false
	if is_instance_valid(terrain):terrain.end_boot_priority()

func _cancel_walk_transition() -> void:
	_walk_when_ground_ready=false
	_release_walk_terrain()

func _invite_test_vessel(prebuilt_id: String) -> void:
	if survey_busy:return
	var result: Dictionary=TEST_VISITORS.invite(state,prebuilt_id)
	if not result.ok:
		feedback.text="Visitor unavailable · "+str(result.get("code","rejected")).replace("_"," ")
		return
	_on_state_changed(result.snapshot,result)
	inspector.select_vessel(str(result.result.vessel_id))
	feedback.text="Empty test visitor ready · Select a suitable berth, then Dock vessel."


func _open_operator(placement_id: String) -> void:
	var preferred:=vessel_session.helm_vessel_id() if is_instance_valid(vessel_session) else ""
	var context: Dictionary=OPERATOR_CONTEXT.resolve(state.to_dict(),placement_id,preferred,catalog)
	if not context.ok:
		feedback.text=str(context.get("message","Operator unavailable."))
		return
	open_inspector()
	if context.tab=="cargo":
		inspector.focus_cargo(str(context.store_id),str(context.vessel_id))
		if str(context.vessel_id).is_empty():feedback.text="No compatible vessel is alongside this facility."
	else:inspector.focus_berths()


func open_inspector() -> void:
	if survey_busy or inspector.visible: return
	_cancel_walk_transition()
	if map.visible: _close_map()
	_inspector_cursor_before=cursor_mode
	_pause_player(true)
	_set_cursor(true)
	inspector.refresh()
	inspector.focus_berths()
	inspector.show()

func _close_inspector() -> void:
	inspector.hide()
	_set_cursor(_inspector_cursor_before)

func open_map() -> void:
	if survey_busy or map.visible: return
	_cancel_walk_transition()
	if inspector.visible: _close_inspector()
	_map_cursor_before=cursor_mode
	_pause_player(true)
	_set_cursor(true)
	map.show()
	map.first_visible_frame=false
	map.camera_initialized=true
	map.camera.focus_harbour(Vector2(site.x,site.z),850)
	map.title_label.text="EXPAND YOUR HARBOUR"
	map.layers.set_visible("plots",true)
	_refresh_plot_map()
	map.first_visible_frame=false
	map._refresh_mode_buttons()
	map._schedule_overlays()
	map._redraw_geography()
	map._redraw_contacts()

func open_new_harbour() -> void:
	if survey_busy: return
	if player.is_vehicle_occupied():
		feedback.text="Leave the helm before starting another harbour."
		return
	if map.visible: _close_map()
	open_map()
	choosing_site=true
	map.selected_plot=""
	map.selected_port=""
	map.title_label.text="CHOOSE YOUR COASTLINE"
	map.camera.focus_harbour(Vector2(site.x,site.z),3000)
	_refresh_plot_map()
	map._schedule_overlays()
	map._redraw_geography()
	map._redraw_contacts()

func open_start_choices() -> void:
	if survey_busy:return
	if player.is_vehicle_occupied():
		feedback.text="Leave the helm before starting another harbour.";return
	if is_instance_valid(start_choices):return
	if map.visible:_close_map()
	if inspector.visible:_close_inspector()
	_cancel_walk_transition()
	_start_cursor_before=cursor_mode
	_start_library_before=library.visible
	_start_overlays_before=overlays.visible
	_set_cursor(true)
	library.hide();overlays.hide()
	if is_instance_valid(ghost):ghost.hide()
	start_choices=Ui.scrim()
	start_choices.add_theme_stylebox_override("panel",VoyageStyle.box(Color(.04,.06,.08,.3),0))
	ui.add_child(start_choices)
	var panel:=Ui.sheet(Vector2(480,0))
	panel.set_anchors_and_offsets_preset(Control.PRESET_CENTER_RIGHT)
	panel.offset_left=-520;panel.offset_right=-32;panel.offset_top=-164;panel.offset_bottom=164
	start_choices.add_child(panel)
	var margin:=Ui.margin(24);panel.add_child(margin)
	var content:=Ui.vbox(16);margin.add_child(content)
	content.add_child(Ui.heading("Your first harbour"))
	var description:=Ui.text("Your fishing boat is ready at the quay. Step aboard and head out.")
	description.autowrap_mode=TextServer.AUTOWRAP_WORD_SMART
	content.add_child(description)
	starter_ready_button=Ui.button("Start at Littlehaven","primary",_choose_starter)
	starter_ready_button.custom_minimum_size.y=48
	content.add_child(starter_ready_button)
	content.add_child(Ui.caption("Fishing boat alongside · Shed · Moorings · Shore access"))
	var detail:=Ui.caption("Build and expand your harbour whenever you're ready.")
	detail.autowrap_mode=TextServer.AUTOWRAP_WORD_SMART
	content.add_child(detail)
	content.add_child(Ui.button("Back","secondary",_close_start_choices))
	starter_ready_button.grab_focus()

func _close_start_choices() -> void:
	if not is_instance_valid(start_choices):return
	start_choices.queue_free();start_choices=null
	library.visible=_start_library_before
	overlays.visible=_start_overlays_before
	_set_cursor(_start_cursor_before)

func _choose_starter() -> Dictionary:
	if not is_instance_valid(start_choices) or survey_busy:return {"ok":false,"code":"choice_unavailable"}
	var plot:=plot_index.plot_at(Vector2(SITE.x,SITE.z+40))
	var bounds:=ChartPlotLayer.plot_rect(plot)
	var plots:Array=[{"id":str(plot.id),"rect_m":[bounds.position.x-SITE.x,bounds.position.y-SITE.z,bounds.size.x,bounds.size.y],"owner_company_id":"company-starter"}]
	var snapshot:=STARTER_EXAMPLE.build(SITE,plots,world_identity,_support_seabed)
	var suffix:="%d-%d"%[Time.get_unix_time_from_system(),Time.get_ticks_usec()]
	snapshot.id="starter-"+suffix
	CustomPortExample.survey(snapshot,_water_seabed,WaveSurface.WATER_LEVEL)
	var next_state:=CustomPortState.from_dict(snapshot,world_identity,catalog)
	if not next_state.validation_errors.is_empty():
		feedback.text="Starter port could not be prepared."
		return {"ok":false,"code":"invalid_starter","errors":next_state.validation_errors}
	var arrival:Dictionary=STARTER_EXAMPLE.arrive(next_state)
	if not arrival.ok:feedback.text="The starter berth is unavailable.";return arrival
	var retained:=REPOSITORY.save("user://custom_ports/retained/before-starter-%s.json"%suffix,state)
	if not retained.ok:feedback.text="Current harbour could not be saved.";return retained
	var next_path:="user://custom_ports/%s.json"%snapshot.id
	var saved:=REPOSITORY.save(next_path,next_state)
	if not saved.ok:feedback.text="Starter port could not be saved.";return saved
	previous_port_copy=retained.path
	_close_start_choices()
	save_path=next_path
	_install_loaded_document({"snapshot":next_state.to_dict(),"state":next_state},true)
	camera.position=site+Vector3(-38,28,13)
	camera.look_at(site+Vector3(0,1,49))
	# Start beside the gangway, facing the boat, with ordinary walking controls.
	home_local=Vector3(5,.15,43)
	player.global_position=site+home_local
	_site_needs_home=false
	var look:PlayerCamera=player.get_node("PlayerCamera")
	look.shift_look_yaw(-look.get_look_yaw())
	walk()
	return {"ok":true,"code":"starter_ready","path":ProjectSettings.globalize_path(save_path)}

func _close_map() -> void:
	map.hide()
	choosing_site=false
	_set_cursor(_map_cursor_before)

func _owned_plot_ids() -> Array[String]:
	var ids: Array[String]=[]
	for plot in state.to_dict().plots: ids.append(str(plot.id))
	return ids

func _available_plot_ids() -> Array[String]:
	var ids: Array[String]=[]
	var snapshot:=state.to_dict()
	var origin:=Vector2(float(snapshot.origin_m[0]),float(snapshot.origin_m[2]))
	for id in plot_index.expansion_frontier(_owned_plot_ids()):
		var bounds:=plot_index.plot_bounds(id)
		bounds.position-=origin
		for owned in snapshot.plots:
			if CustomPortState._adjacent(CustomPortState._as_rect(owned.rect_m),bounds):
				ids.append(id); break
	return ids

func _refresh_plot_map() -> void:
	_refresh_chart_data()
	var available:=_available_plot_ids()
	if choosing_site:
		available=plot_index.plot_ids()
		for id in _owned_plot_ids(): available.erase(id)
	map.renderer.plots.set_ownership_status(_owned_plot_ids(),available)
	map._refresh_plot_panel()
	map._redraw_geography()
	map._redraw_contacts()

func _refresh_chart_data() -> void:
	var snapshot:=state.to_dict()
	if state.revision()==_chart_revision and str(snapshot.id)==_chart_port_id:return
	var summary:=CHART_PROJECTION.project(snapshot,catalog,state.derived_berths())
	map.set_data_snapshot(CHART_PROJECTION.chart_snapshot(layout,[summary]))
	_chart_revision=state.revision()
	_chart_port_id=str(snapshot.id)

func _plot_inspector_content(plot: Dictionary) -> Dictionary:
	if choosing_site: return _new_site_content(plot)
	var balance:=float(simulated_accounts[owner_company_id].balance_nok)
	var budget:="Workshop budget · %.0f NOK"%balance
	var result:={"heading":"Expand your harbour","meta":"Blue · Owned   Green · Available",
		"body":"Select a green plot beside your harbour.\nReview its price, then choose Buy plot.\n\n"+budget,
		"action_text":"Buy plot · %.0f NOK"%PLOT_PRICE_NOK,"action_visible":false,"action_enabled":false}
	if plot.is_empty(): return result
	var id:=str(plot.get("id",""))
	var grid: Array=plot.get("grid",[0,0])
	result.heading="Coast plot %s / %s"%[grid[0],grid[1]]
	result.meta="200 × 200 m · 4 hectares"
	if id in _owned_plot_ids():
		result.body="Owned by your harbour.\nChoose an adjoining green plot to expand.\n\n"+budget
		return result
	result.action_visible=true
	if id not in _available_plot_ids():
		result.body="Not adjoining your harbour.\nExpand along the connected green plots first.\n\n"+budget
		return result
	result.body="Available beside your harbour.\nPrice · %.0f NOK\n\n%s"%[PLOT_PRICE_NOK,budget]
	result.action_enabled=not survey_busy and balance>=PLOT_PRICE_NOK
	if balance<PLOT_PRICE_NOK: result.body+="\nNot enough funds for this plot."
	return result

func _buy_plot(plot: Dictionary) -> void:
	if survey_busy: return
	if choosing_site:
		await _start_selected_harbour(str(plot.get("id","")))
		return
	# A chart selection is inspection only. This handler is connected exclusively
	# to the explicit purchase action and rechecks availability at that moment.
	if not bool(_plot_inspector_content(plot).get("action_enabled",false)):
		map._refresh_plot_panel(); return
	var snapshot:=state.to_dict()
	var bounds:=ChartPlotLayer.plot_rect(plot)
	var origin:=CustomPortCatalog.vector3(snapshot.origin_m)
	var offer:={"available":true,"owner_company_id":"","price_nok":PLOT_PRICE_NOK,"world":world_identity,
		"rect_m":[bounds.position.x-origin.x,bounds.position.y-origin.z,bounds.size.x,bounds.size.y]}
	var result:=_command("buy_plot",{"plot_id":str(plot.id)}, {"plot_offers":{str(plot.id):offer},"accounts":simulated_accounts})
	if result.ok:
		for delta in result.get("account_changes",[]): simulated_accounts[delta.company_id].balance_nok=delta.balance_nok
		_close_map()
		if await _survey_expansion():
			feedback.text="Plot added · Workshop budget %.0f NOK" % float(simulated_accounts[owner_company_id].balance_nok)
	else:
		feedback.text=str(result.code).replace("_"," ")
		map.plot_body.text="Purchase failed · "+feedback.text

func _new_site_content(plot: Dictionary) -> Dictionary:
	var result:={"heading":"Choose your coastline","meta":"New workshop harbour",
		"body":"Select a green coastal plot anywhere on this island world.\n\nYour first plot is included. Further plots cost 25,000 NOK from the workshop budget.\n\nStarting here saves a separate copy of your current harbour.",
		"action_text":"Start harbour here","action_visible":false,"action_enabled":false}
	if plot.is_empty(): return result
	var actual:=plot_index.get_plot(str(plot.get("id","")))
	if actual.is_empty(): return result
	result.heading="Coast plot %s / %s"%[actual.grid[0],actual.grid[1]]
	result.meta="200 × 200 m · 4 hectares"
	if str(actual.id) in _owned_plot_ids():
		result.body="This plot belongs to the current harbour. Choose another coastline for a new build."
		return result
	result.action_visible=true
	result.action_enabled=not survey_busy
	if bool(actual.get("boundary_review_required",false)):
		result.body+="\n\nThis square contains more than one shoreline. Review its shape before building."
	return result

func _start_selected_harbour(plot_id: String) -> Dictionary:
	if not choosing_site or survey_busy: return {"ok":false,"code":"not_choosing_site"}
	if player.is_vehicle_occupied(): return {"ok":false,"code":"leave_helm_first"}
	var plot:=plot_index.get_plot(plot_id)
	if plot.is_empty() or plot_id in _owned_plot_ids(): return {"ok":false,"code":"plot_unavailable"}
	var suffix:="%d-%d"%[Time.get_unix_time_from_system(),Time.get_ticks_usec()]
	var port_id:="harbour-%s-%s"%[plot_id.sha256_text().left(8),suffix]
	var plan: Dictionary=SITE_PLAN.plan(plot_id,plot_index,world_identity,port_id,owner_company_id,"Harbour %s / %s"%[plot.grid[0],plot.grid[1]])
	if not plan.ok:
		map.plot_body.text="Cannot start here · "+str(plan.code)
		return plan
	# Each switch retains a unique complete document, including unfinished cargo
	# operations. It never overwrites an older/higher revision or the input file.
	var retained_path:="user://custom_ports/retained/%s-%s.json"%[str(state.to_dict().id).sha256_text().left(12),suffix]
	var retained: Dictionary=REPOSITORY.save(retained_path,state)
	if not retained.ok:
		map.plot_body.text="Current harbour could not be saved · "+str(retained.code)
		return retained
	var next_state:=CustomPortState.from_dict(plan.snapshot,world_identity,catalog)
	var next_path:="user://custom_ports/%s.json"%port_id
	var initial_save: Dictionary=REPOSITORY.save(next_path,next_state)
	if not initial_save.ok:
		map.plot_body.text="New harbour could not be saved · "+str(initial_save.code)
		return initial_save
	previous_port_copy=retained.path
	_close_map()
	build()
	player._clear_ship_mount()
	state=next_state
	save_path=next_path
	site=CustomPortCatalog.vector3(plan.snapshot.origin_m)
	simulated_accounts={owner_company_id:{"balance_nok":WORKSHOP_BUDGET_NOK}}
	_chart_revision=-1
	_map_cursor_before=true
	heading.text=str(plan.snapshot.name)+" · Port workshop"
	_connect_editor()
	inspector.configure(state,catalog)
	inspector.set_storage_admin_actor(owner_company_id)
	_on_state_changed(state.to_dict(),{})
	var anchor: Vector2=Vector2(float(plot.shore_anchor[0]),float(plot.shore_anchor[1]))
	var look:=Vector3(anchor.x,site.y,anchor.y)
	# Keep the view above existing hills; the construction plane stays at sea+2.
	look.y=maxf(look.y,_water_seabed(anchor))
	camera.position=look+Vector3(-95,90,-95)
	camera.position.y=maxf(camera.position.y,_water_seabed(Vector2(camera.position.x,camera.position.z))+18)
	camera.look_at(look)
	camera.reset_physics_interpolation()
	_site_needs_home=true
	var home:=_find_home()
	home_local=home.local if home.ok else Vector3(0,10,0)
	player.position=site+home_local
	player.velocity=Vector3.ZERO
	player.reset_physics_interpolation()
	terrain.begin_boot_priority(site)
	_set_cursor(true)
	await _survey_expansion()
	terrain.end_boot_priority()
	var saved: Dictionary=REPOSITORY.save(save_path,state)
	feedback.text="New harbour ready · Tab to fly and build. Previous harbour saved separately."
	feedback.tooltip_text=previous_port_copy
	if not saved.ok:feedback.text="Harbour ready · Save needs retry: "+str(saved.code)
	return {"ok":true,"code":"created","previous_path":previous_port_copy,"path":ProjectSettings.globalize_path(save_path),"port_id":port_id}

func _find_home() -> Dictionary:
	var snapshot:=state.to_dict()
	var radius:=.35
	var capsule_height:=1.8
	if is_instance_valid(player):
		var volume:=player.get_node_or_null("CollisionShape3D") as CollisionShape3D
		if volume!=null and volume.shape is CapsuleShape3D:
			radius=volume.shape.radius
			capsule_height=volume.shape.height
	var context:=HOME_PLACEMENT.prepare(snapshot,catalog,radius,capsule_height)
	var deck: Dictionary=HOME_PLACEMENT.find(context,_home_capsule_clear)
	if deck.ok:return deck
	# Empty shoreline parcels may be steep or mostly water. Walk on an actual
	# dry terrain point, never at the sea-level plane inside an uncut hillside.
	var best:=Vector3.ZERO
	var best_height:=INF
	for owned in snapshot.plots:
		var bounds:=CustomPortState._as_rect(owned.rect_m)
		for z in range(4,int(bounds.size.y),8):
			for x in range(4,int(bounds.size.x),8):
				var local:=bounds.position+Vector2(x,z)
				# Raw terrain beneath constructed decks may have been excavated.
				# A blocked deck cannot become a safe home by using its old hill.
				if HOME_PLACEMENT.supported(context,local):continue
				var height:=_water_seabed(Vector2(site.x,site.z)+local)
				if height>=WaveSurface.WATER_LEVEL+1.2 and height<best_height:
					if not _home_capsule_clear(Vector3(local.x,height-site.y+.2,local.y)):continue
					best_height=height
					best=Vector3(local.x,height-site.y+.2,local.y)
	return {"ok":is_finite(best_height),"local":best}

func _home_capsule_clear(local: Vector3) -> bool:
	# Startup can choose from saved geometry before render nodes exist. Once
	# instantiated, use real collision rather than broad equipment footprints;
	# walkable pump aisles and open doors must remain valid standing positions.
	if not is_instance_valid(player) or not player.is_inside_tree():return true
	var body:=player.get_node_or_null("CollisionShape3D") as CollisionShape3D
	if body==null or body.shape==null:return false
	var query:=PhysicsShapeQueryParameters3D.new()
	query.shape=body.shape
	query.transform=Transform3D(Basis.IDENTITY,site+local+body.position+Vector3.UP*.02)
	query.collision_mask=player.collision_mask
	query.exclude=[player.get_rid()]
	return get_world_3d().direct_space_state.intersect_shape(query,1).is_empty()

func _player_ground_is_safe() -> bool:
	if player.is_deck_mounted():return true
	if not _home_capsule_clear(player.global_position-site):return false
	var local:=Vector2(player.global_position.x-site.x,player.global_position.z-site.z)
	var snapshot:=state.to_dict()
	for row in snapshot.placements:
		var spec: Dictionary=catalog.get(str(row.asset_id),{})
		if str(spec.get("kind",""))!="platform":continue
		for polygon in CustomPortPlacementRules.polygons(row,spec):
			if Geometry2D.is_point_in_polygon(local,polygon):return player.global_position.y>=site.y-.15
	var ground:=_water_seabed(Vector2(player.global_position.x,player.global_position.z))
	return ground>=WaveSurface.WATER_LEVEL+1.2 and player.global_position.y>=ground-.15

func return_home() -> void:
	if survey_busy or player.is_vehicle_occupied():return
	var home:=_find_home()
	if not home.ok:
		feedback.text="Build a foundation before returning home here."
		return
	home_local=home.local
	player._clear_ship_mount()
	player.global_position=site+home_local
	player.velocity=Vector3.ZERO
	player.reset_physics_interpolation()
	_home_dirty=false
	_site_needs_home=false
	if not building or _walk_when_ground_ready:
		_ground_pause=true
		_pause_player(true)
		_walk_when_ground_ready=true
		_pin_walk_terrain()
		feedback.text="Preparing the ground at home…"

func _survey_expansion() -> bool:
	var survey=preload("res://scripts/port/state/custom_port_water_survey.gd").begin(state.to_dict(),_water_seabed,WaveSurface.WATER_LEVEL)
	if not survey.get("ok",false):
		feedback.text="Plot owned · water survey unavailable"; return false
	var job=survey.job
	var restore_cursor:=cursor_mode
	survey_busy=true
	_set_cursor(true)
	while not job.progress().done:
		var progress: Dictionary=job.step(16,4.0)
		feedback.text="Surveying the expanded waterfront · %.0f%%" % (float(progress.get("progress",0))*100.0)
		await get_tree().process_frame
	var context: Dictionary=job.authority_context()
	var completed:=false
	if not context.is_empty():
		var result:=_command("refresh_water_survey",{},context)
		completed=result.ok
		if not result.ok: feedback.text="Plot owned · survey needs retry: "+str(result.code)
	else: feedback.text="Plot owned · water survey failed: "+str(job.progress().code)
	survey_busy=false
	_set_cursor(restore_cursor)
	return completed

func _command(kind: String, payload: Dictionary, context: Dictionary={}) -> Dictionary:
	command_sequence+=1
	var result:=state.apply({"command_id":"workshop-%d-%d"%[Time.get_ticks_usec(),command_sequence],"expected_revision":state.to_dict().revision,
		"actor_company_id":owner_company_id,"kind":kind,"payload":payload},context)
	if result.ok: _on_state_changed(result.snapshot,result)
	return result

func _on_state_changed(snapshot: Dictionary, _result: Dictionary) -> void:
	_home_dirty=true
	heading.text=str(snapshot.get("name","Harbour"))+" · Port workshop"
	if is_instance_valid(vessel_session):vessel_session.set_state(state)
	transfers.present(snapshot,state.derived_berths(),_result.get("events",[]))
	placement_picker.rebuild()
	_earthworks_dirty=true
	if not painting: _sync_earthworks()
	inspector.refresh()
	_update_overlays()
	ghost_key=""

func _sync_earthworks() -> void:
	if not _earthworks_dirty or not is_instance_valid(terrain): return
	_earthworks_dirty=false
	var projection: Dictionary=EARTHWORKS.project(state.to_dict(),catalog,state.construction_edges())
	terrain.set_custom_port_earthworks([projection])
	if is_instance_valid(forest):forest.set_custom_port_exclusions("custom-port-workshop",EARTHWORKS.forest_exclusions(projection))
	if not building and not terrain.is_custom_port_earthworks_ready():
		_ground_pause=true
		_pause_player(true)

func _finish_ground_update() -> void:
	# A painted stroke updates one terrain projection. Free flight continues
	# while it builds; walking waits for the matching collider, not just a mesh.
	if _earthworks_dirty and not painting: _sync_earthworks()
	if _walk_when_ground_ready:_pin_walk_terrain()
	if not is_instance_valid(terrain) or not terrain.is_custom_port_earthworks_ready(): return
	if (_ground_pause or _walk_when_ground_ready) and not terrain.is_ready_around(player.global_position,35):return
	if _ground_pause:
		_ground_pause=false
		_pause_player(building or cursor_mode)
	if _walk_when_ground_ready and terrain.is_ready_around(player.global_position,35): walk()

func save_port() -> void:
	var result: Dictionary=REPOSITORY.save(save_path,state)
	feedback.text="Port saved · "+save_path.get_file() if result.ok else "Save failed · "+str(result.code)
	feedback.tooltip_text=ProjectSettings.globalize_path(save_path) if result.ok else ""

func load_port() -> void:
	if survey_busy: return
	if player.is_vehicle_occupied():
		feedback.text="Leave the helm before restoring a harbour.";return
	var result: Dictionary=_load_workshop_document(save_path)
	if not result.ok:
		feedback.text="Load failed · "+str(result.code); return
	_install_loaded_document(result,false)
	feedback.text="Port restored from its saved data"+(" · recovered backup" if result.get("recovered_from_backup",false) else "")

func open_document_picker() -> void:
	if survey_busy: return
	if player.is_vehicle_occupied():
		feedback.text="Leave the helm before opening another harbour.";return
	var directory:=ProjectSettings.globalize_path(save_path).get_base_dir()
	if DirAccess.make_dir_recursive_absolute(directory)!=OK:
		feedback.text="Could not open the harbour save folder.";return
	_cancel_walk_transition()
	if map.visible:_close_map()
	if inspector.visible:_close_inspector()
	_file_cursor_before=cursor_mode
	_pause_player(true)
	_set_cursor(true)
	document_picker.current_dir=directory
	document_picker.popup_centered_ratio(.8)

func _on_document_selected(path: String) -> void:
	var result:=open_port_document(path)
	if not result.ok:
		feedback.text="Cannot open harbour · "+str(result.code).replace("_"," ")
		_set_cursor(_file_cursor_before)

func open_port_document(path: String) -> Dictionary:
	if survey_busy:return {"ok":false,"code":"survey_in_progress"}
	if player.is_vehicle_occupied():return {"ok":false,"code":"leave_helm_first"}
	var loaded: Dictionary=_load_workshop_document(path)
	if not loaded.ok:return loaded
	var suffix:="%d-%d"%[Time.get_unix_time_from_system(),Time.get_ticks_usec()]
	var retained_path:="user://custom_ports/retained/%s-%s.json"%[str(state.to_dict().id).sha256_text().left(12),suffix]
	var retained: Dictionary=REPOSITORY.save(retained_path,state)
	if not retained.ok:return retained
	var destination:="user://custom_ports/imported-%s-%s.json"%[str(loaded.snapshot.id).sha256_text().left(12),suffix]
	var saved: Dictionary=REPOSITORY.save(destination,loaded.state)
	if not saved.ok:return saved
	previous_port_copy=retained.path
	save_path=destination
	_install_loaded_document(loaded,true)
	feedback.text="Harbour opened · Source preserved. Edits save to a separate copy."
	feedback.tooltip_text=ProjectSettings.globalize_path(save_path)
	return {"ok":true,"code":"opened","path":ProjectSettings.globalize_path(save_path),"previous_path":previous_port_copy}

func _install_loaded_document(loaded: Dictionary, move_view: bool) -> void:
	_cancel_move()
	_cancel_walk_transition()
	var incoming_site:=CustomPortCatalog.vector3(loaded.snapshot.origin_m)
	move_view=move_view or player.is_deck_mounted() or incoming_site!=site or str(loaded.snapshot.id)!=str(state.to_dict().id)
	if move_view:
		if map.visible:_close_map()
		build()
		player._clear_ship_mount()
	state=loaded.state
	site=incoming_site
	owner_company_id=str(loaded.snapshot.owner_company_id)
	_chart_revision=-1
	heading.text=str(state.to_dict().name)+" · Port workshop"
	# The workshop grants one plot; its test allowance is derived from owned
	# plots. A production backend must use the existing company ledger instead.
	simulated_accounts={owner_company_id:{"balance_nok":maxf(0,WORKSHOP_BUDGET_NOK-PLOT_PRICE_NOK*(state.to_dict().plots.size()-1))}}
	_connect_editor()
	inspector.configure(state,catalog)
	inspector.set_storage_admin_actor(owner_company_id)
	_on_state_changed(state.to_dict(),{})
	if move_view:
		_site_needs_home=true
		var home:=_find_home()
		home_local=home.local if home.ok else Vector3(0,10,0)
		player.global_position=site+home_local
		player.velocity=Vector3.ZERO
		player.reset_physics_interpolation()
		camera.position=site+Vector3(-105,78,-100)
		camera.position.y=maxf(camera.position.y,_water_seabed(Vector2(camera.position.x,camera.position.z))+18)
		camera.look_at(site+Vector3(0,8,26))
		camera.reset_physics_interpolation()
		_set_cursor(true)

func _load_workshop_document(path: String) -> Dictionary:
	var result: Dictionary=REPOSITORY.load_state(path,world_identity,catalog)
	if not result.ok:return result
	# World-specific datum policy belongs here, not in the reusable data authority.
	# Both startup injection and Load reject a second construction plane before
	# changing state, terrain, camera or the installed harbour presentation.
	var plane: Dictionary=WORLD_POLICY.validate_deck_plane(result.snapshot)
	if not plane.ok:return plane
	var vessels:=CustomPortVesselProjection.validate_snapshot(result.snapshot)
	if not vessels.ok:return vessels
	return result

func _update_overlays() -> void:
	for child in overlays.get_children(): child.queue_free()
	var snapshot:=state.to_dict()
	var origin:=CustomPortCatalog.vector3(snapshot.origin_m)
	for plot in snapshot.plots:
		var r: Array=plot.rect_m
		var bounds:=Rect2(float(r[0])+origin.x,float(r[1])+origin.z,float(r[2]),float(r[3]))
		overlays.add_child(PlotBuildVisuals.plot_overlay(layout,bounds,false))
		overlays.add_child(PlotBuildVisuals.plot_overlay(layout,bounds,true,origin.y,Vector2(4,4),Vector2(origin.x-bounds.position.x,origin.z-bounds.position.y)))
	for berth in state.derived_berths():
		var outline:=BUILD_GUIDES.berth_outline(berth)
		outline.position=origin
		overlays.add_child(outline)
		var label:=Label3D.new()
		label.text="Berth · %.0f m\nDepth %.1f m"%[float(berth.max_length_m),float(berth.depth_m)]
		label.font_size=40; label.pixel_size=.018
		label.billboard=BaseMaterial3D.BILLBOARD_ENABLED
		label.position=origin+CustomPortCatalog.vector3(berth.center_m)+Vector3.UP*3
		label.modulate=Color("a1e2cc")
		overlays.add_child(label)

func _process(delta: float) -> void:
	if not building or cursor_mode or survey_busy or _walk_when_ground_ready:build_guides.hide()
	if ready_for_review: _finish_ground_update()
	if ready_for_review and not building and not cursor_mode and is_instance_valid(vessel_session) and player.is_vehicle_occupied() and Time.get_ticks_msec()>_sailing_feedback_until:
		feedback.text=vessel_session.helm_status()
	if not ready_for_review or not building or cursor_mode or survey_busy or _walk_when_ground_ready: return
	camera.fly(delta)
	if editor==null: return
	var center:=get_viewport().get_visible_rect().size*.5
	var start:=camera.project_ray_origin(center)
	var direction:=camera.project_ray_normal(center)
	_update_hovered_placement(start,direction)
	if cladding_paint_mode:
		build_guides.hide()
		preview={}
		_build_cursor_valid=false
		if is_instance_valid(ghost):ghost.hide()
		if painting:_paint_cladding_target()
		elif not hovered_id.is_empty():feedback.text="Paint cladding · hold LMB · RMB returns to building · Ctrl+Z undo"
		else:feedback.text="Aim at a wall, window or door · RMB returns to building"
		return
	var hit: Variant=Plane(Vector3.UP,presenter.position.y).intersects_ray(start,direction)
	if hit==null:
		build_guides.hide()
		_build_cursor_valid=false
		preview={}
		ghost_key=""
		if is_instance_valid(ghost):ghost.hide()
		if not hovered_id.is_empty():feedback.text="Middle mouse · Move piece   RMB · Remove"
		return
	var local: Vector3=hit-presenter.position
	_build_cursor_local=local
	_build_cursor_valid=true
	var asset_id:=selected if moving_id.is_empty() else moving_asset_id
	preview=editor.call("preview",asset_id,local,build_yaw_degrees) if moving_id.is_empty() else editor.call("preview_transform",moving_id,local+_move_cursor_offset,build_yaw_degrees)
	build_guides.position=presenter.position
	build_guides.present(preview,catalog)
	if not overlays.visible:build_guides.hide()
	var row: Dictionary=preview.get("placement",{})
	var key:=JSON.stringify([row,preview.get("ok",false)])
	if key!=ghost_key:
		ghost_key=key
		if not row.is_empty():
			var visual_key:="%s:%s"%[asset_id,bool(preview.ok)]
			if visual_key!=ghost_model_key or not is_instance_valid(ghost):
				if is_instance_valid(ghost):ghost.queue_free()
				var spec: Dictionary=catalog[asset_id]
				if str(spec.kind)=="npc": ghost=NpcBase.new()
				else: ghost=PlotBuildVisuals.create(spec,true,bool(preview.ok)) if spec.has("cells") else CustomPortPresenter.asset_visual(spec,true,bool(preview.ok))
				add_child(ghost)
				ghost_model_key=visual_key
			ghost.show()
			ghost.position=presenter.position+CustomPortCatalog.vector3(row.position_m)
			ghost.rotation.y=deg_to_rad(float(row.yaw_degrees))
		var verb:="LMB to place" if moving_id.is_empty() else "LMB to confirm · R rotate · RMB cancel"
		feedback.text=("" if moving_id.is_empty() else "Move · ")+str(catalog[asset_id].name)+" · "+(verb if preview.get("ok",false) else _placement_hint(str(preview.get("message","Cannot build here"))))
	if painting and bool(preview.get("ok",false)) and key!=painted_key:
		painted_key=key
		_place()

func _update_hovered_placement(start: Vector3, direction: Vector3) -> void:
	var ray:=PhysicsRayQueryParameters3D.create(start,start+direction*500,1)
	ray.exclude=[player.get_rid()]
	var contact:=get_world_3d().direct_space_state.intersect_ray(ray)
	var distance:=500.0
	hovered_id=""
	if not contact.is_empty():
		distance=start.distance_to(contact.position)+.015
		var node: Node=contact.collider
		while node!=null:
			if node.has_meta("port_placement_id"): hovered_id=str(node.get_meta("port_placement_id")); break
			node=node.get_parent()
	# Exact visible triangles select thin, non-colliding decoration before the
	# wall behind it. Gameplay collision still occludes terrain and ships; NPCs
	# retain the physical fallback rather than selecting their bind-pose meshes.
	var visual: Dictionary=placement_picker.pick(start,direction,distance)
	if not visual.is_empty():hovered_id=str(visual.placement_id)

func _clear_build_target() -> void:
	build_guides.hide()
	preview={}
	_build_cursor_valid=false
	hovered_id=""
	ghost_key=""
	if is_instance_valid(ghost): ghost.hide()

func _placement_hint(problem: String) -> String:
	if problem.contains(" overlaps "):return "That space is occupied"
	if problem.contains("needs a supporting quay edge"):return "Place along an exposed quay edge"
	if problem.contains("needs foundations beneath"):return "Build foundations beneath the whole piece"
	if problem.contains("shared deck datum"):return "Use the shared deck level"
	if problem.contains("construction rotation"):return "Rotate to match the building grid"
	return problem

func _place() -> void:
	if editor==null or not preview.get("ok",false) or not _construction_ready(): return
	_prepare_support_depth(preview.placement)
	var result: Dictionary=editor.call("place",preview)
	if result.get("ok",false): _on_state_changed(state.to_dict(),result)
	else: feedback.text=str(result.get("message",result.get("code","Placement failed")))

func _prepare_support_depth(placement: Dictionary) -> void:
	var spec: Dictionary=catalog.get(str(placement.asset_id),{})
	if str(spec.get("kind",""))=="platform":
		var depth:=4.0
		for polygon in CustomPortPlacementRules.polygons(placement,spec):
			for local in polygon:
				var at:=Vector2(presenter.position.x,presenter.position.z)+local
				depth=maxf(depth,presenter.position.y-_support_seabed(at)+.5)
		placement.attributes.support_depth_m=depth

func _construction_ready() -> bool:
	if is_instance_valid(transfers) and transfers.is_busy():
		feedback.text="Wait for the cargo transfer to finish before editing."
		return false
	return true

func _begin_move(placement_id: String) -> void:
	if not building or editor==null or placement_id.is_empty() or not _construction_ready():return
	for row in state.to_dict().placements:
		if str(row.id)!=placement_id:continue
		var offset:=CustomPortCatalog.vector3(row.position_m)-_build_cursor_local if _build_cursor_valid else Vector3.ZERO
		_cancel_move()
		painting=false
		editor.end_edit()
		_yaw_before_move=build_yaw_degrees
		moving_id=placement_id
		moving_asset_id=str(row.asset_id)
		_move_cursor_offset=offset
		build_yaw_degrees=float(row.yaw_degrees)
		_clear_build_target()
		return

func _cancel_move() -> void:
	if moving_id.is_empty():return
	moving_id=""
	moving_asset_id=""
	build_yaw_degrees=_yaw_before_move
	_clear_build_target()

func _confirm_move() -> void:
	if moving_id.is_empty() or not preview.get("ok",false) or not _construction_ready():return
	_prepare_support_depth(preview.placement)
	var result: Dictionary=editor.call("transform",preview)
	if result.get("ok",false):
		_cancel_move()
		_on_state_changed(state.to_dict(),result)
		feedback.text="Piece moved · Ctrl+Z to undo"
	else:feedback.text=str(result.get("message",result.get("code","Cannot move this piece")))

func _input(event: InputEvent) -> void:
	if is_instance_valid(start_choices):
		if event is InputEventKey and event.pressed and event.keycode==KEY_ESCAPE:
			_close_start_choices();get_viewport().set_input_as_handled()
		elif event.is_action_pressed("interact"):get_viewport().set_input_as_handled()
		return
	# Pausing the player does not pause NPC/helm unhandled input. Their ray would
	# otherwise still use the inactive player camera behind build and modal UI.
	if event.is_action_pressed("interact") and (not ready_for_review or _capture_mode or survey_busy or
		building or cursor_mode or _ground_pause or _walk_when_ground_ready or
		(is_instance_valid(map) and map.visible) or (is_instance_valid(inspector) and inspector.visible) or
		(is_instance_valid(document_picker) and document_picker.visible)):
		var focus:=get_viewport().gui_get_focus_owner()
		# Let a real printable key reach its focused text field, where GUI input
		# consumes it. Non-text interaction presses stop before world handlers.
		var typing: bool=event is InputEventKey and event.unicode>=32 and not event.ctrl_pressed and not event.alt_pressed and not event.meta_pressed and (
			(focus is LineEdit and focus.editable) or (focus is TextEdit and focus.editable))
		if not typing:get_viewport().set_input_as_handled()
		return
	if not ready_for_review or _capture_mode or survey_busy: return
	if is_instance_valid(document_picker) and document_picker.visible:return
	if event is InputEventKey and event.pressed and not event.echo:
		# _input runs before a LineEdit gets the key. Typing a piece name must
		# not rotate, open the map, undo construction or start walking.
		var focus:=get_viewport().gui_get_focus_owner()
		if focus is LineEdit and library.is_ancestor_of(focus):
			if event.keycode==KEY_ESCAPE:
				focus.release_focus()
				get_viewport().set_input_as_handled()
			elif event.keycode==KEY_TAB:
				_set_cursor(false)
				get_viewport().set_input_as_handled()
			return
		if event.keycode==KEY_ESCAPE:
			if map.visible: _close_map()
			elif inspector.visible: _close_inspector()
			elif not moving_id.is_empty(): _cancel_move()
			elif player.is_vehicle_occupied():vessel_session.leave_helm()
			else: walk() if building else build()
			get_viewport().set_input_as_handled(); return
		if inspector.visible or map.visible: return
		# Helm number keys set engine orders. Only an on-foot player equips the
		# build tool; Escape leaves the station before it can enter freecam.
		if player.is_vehicle_occupied() and event.keycode in [KEY_1,KEY_R,KEY_G,KEY_H]:return
		match event.keycode:
			KEY_1: build()
			KEY_TAB: _set_cursor(not cursor_mode)
			KEY_R:
				if not moving_id.is_empty() and _build_cursor_valid and not preview.get("placement",{}).is_empty():
					_move_cursor_offset=CustomPortCatalog.vector3(preview.placement.position_m)-_build_cursor_local
				build_yaw_degrees=fposmod(build_yaw_degrees+90,360)
				ghost_key=""
			KEY_M: open_map()
			KEY_H: return_home()
			KEY_G: overlays.visible=not overlays.visible
			KEY_S:
				if event.ctrl_pressed: save_port(); get_viewport().set_input_as_handled(); return
			KEY_Z:
				if event.ctrl_pressed and editor!=null:
					if not _construction_ready():get_viewport().set_input_as_handled();return
					_cancel_move()
					painting=false
					var result: Dictionary=editor.call("undo")
					if result.get("ok",false): _on_state_changed(state.to_dict(),result)
					else: feedback.text=str(result.get("code","Nothing to undo"))
	if building and not cursor_mode and not _walk_when_ground_ready:
		if event is InputEventMouseButton:
			if cladding_paint_mode:
				if event.button_index==MOUSE_BUTTON_LEFT:
					painting=event.pressed
					if painting:
						_painted_cladding.clear()
						editor.begin_edit()
						_paint_cladding_target()
					else:editor.end_edit()
				elif event.button_index==MOUSE_BUTTON_RIGHT and event.pressed:_leave_cladding_paint()
				if event.button_index in [MOUSE_BUTTON_LEFT,MOUSE_BUTTON_RIGHT,MOUSE_BUTTON_MIDDLE]:
					get_viewport().set_input_as_handled();return
			if event.button_index==MOUSE_BUTTON_MIDDLE and event.pressed:
				_begin_move(hovered_id)
				get_viewport().set_input_as_handled();return
			if not moving_id.is_empty():
				if event.button_index==MOUSE_BUTTON_LEFT and event.pressed:_confirm_move()
				elif event.button_index==MOUSE_BUTTON_RIGHT and event.pressed:_cancel_move()
				if event.button_index in [MOUSE_BUTTON_LEFT,MOUSE_BUTTON_RIGHT]:get_viewport().set_input_as_handled();return
			if event.button_index==MOUSE_BUTTON_LEFT:
				painting=event.pressed
				if editor!=null: editor.call("begin_edit" if painting else "end_edit")
				if painting: painted_key=""; _place()
			elif event.button_index==MOUSE_BUTTON_RIGHT and event.pressed and editor!=null and not hovered_id.is_empty():
				if not _construction_ready():get_viewport().set_input_as_handled();return
				var result: Dictionary=editor.call("remove",hovered_id)
				if result.get("ok",false): _on_state_changed(state.to_dict(),result)
				else: feedback.text=str(result.get("code","Cannot remove"))
		camera.handle_input(event)

func _review() -> void:
	await get_tree().create_timer(1.5).timeout
	_set_cursor(true)
	library.hide(); overlays.hide()
	for shot in [
		{"name":"waterfront-overview","at":Vector3(-145,70,-60),"look":Vector3(-25,3,28)},
		{"name":"sheltered-inlet","at":Vector3(-80,17,-17),"look":Vector3(-100,2,28)},
		{"name":"working-waterfront","at":Vector3(-67,4,44),"look":Vector3(-39,2.2,56)},
		{"name":"net-loft-human-scale","at":Vector3(-98,2.1,6),"look":Vector3(-109,2.3,22)},
		{"name":"eight-metre-diagonal","at":Vector3(-129,8,-8),"look":Vector3(-112,0,7)},
		{"name":"quay-walking-scale","at":Vector3(-57,2.2,5),"look":Vector3(15,2,8)},
		{"name":"crane-and-cargo","at":Vector3(-7,38,-36),"look":Vector3(-22,5,25)},
		{"name":"angled-quay-corner","at":Vector3(-78,5,-6),"look":Vector3(-69,0,3)},
		{"name":"modular-workshop","at":Vector3(-26,5,42),"look":Vector3(-36,2.4,54)},
		{"name":"harbour-office","at":Vector3(-9,4,41),"look":Vector3(-20,4,56)},
		{"name":"shore-access","at":Vector3(14,7,87),"look":Vector3(-4,.5,72)}]:
		camera.position=site+shot.at
		camera.look_at(site+shot.look)
		await get_tree().create_timer(.3).timeout
		await _capture(str(shot.name))
	open_inspector()
	await get_tree().process_frame
	await _capture("data-inspector")
	save_port()
	print("CUSTOM_PORT_CAPTURE_COMPLETE")
	get_tree().quit()

func _capture(label: String) -> void:
	await RenderingServer.frame_post_draw
	var folder:="C:/Users/noahs/Pictures/machinescreenshots"
	DirAccess.make_dir_recursive_absolute(folder)
	var path:=folder.path_join("custom-port-%d-%d-%s.png"%[Time.get_unix_time_from_system(),OS.get_process_id(),label])
	get_viewport().get_texture().get_image().save_png(path)
	print("CUSTOM_PORT_CAPTURE ",path)

func _exit_tree() -> void:
	placement_picker.clear()
	if is_instance_valid(vessel_session):vessel_session.shutdown()
	_release_walk_terrain()
	if is_instance_valid(forest):forest.set_custom_port_exclusions("custom-port-workshop",[])
	Input.mouse_mode=Input.MOUSE_MODE_VISIBLE
