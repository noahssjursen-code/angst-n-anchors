func _ready() -> void:
	assert(ShipyardPlaytestMode.active())
	_capture_mode=OS.get_cmdline_user_args().has("--capture-custom-port")
	WorldClock.snap_time_of_day(.43)
	WorldClock.set_process(false)
	WeatherLighting.set_process(false)
	WeatherLighting.time_of_day=.43
	WeatherLighting.cloud_cover=.18
	WeatherLighting.precipitation=0
	WeatherLighting.wind_force=.15
	WeatherLighting.sea_state=.08
	layout=WorldLayoutGenerator.generate(SEED,WorldLayoutGenerator.DEFAULT_CONFIG_PATH,WORLD_SIZE)
	LandField.initialize(layout)
	ForestField.initialize(layout,SEED)
	plot_index=CoastalPlotIndex.for_layout(layout)
	world_identity={"seed":SEED,"generation_version":WorldLayoutGenerator.GENERATION_VERSION,"checksum":layout.layout_checksum}
	catalog=CustomPortCatalog.definitions()
	var input_path:=""
	for argument in OS.get_cmdline_user_args():
		if argument.begins_with("--port-document="):input_path=argument.trim_prefix("--port-document=")
	var snapshot: Dictionary
	if not input_path.is_empty():
		var imported: Dictionary=_load_workshop_document(input_path)
		if not imported.ok:
			push_error("Cannot open port document: "+str(imported.code)+" "+str(imported.get("errors",[])))
			get_tree().quit(1);return
		snapshot=imported.snapshot
		site=CustomPortCatalog.vector3(snapshot.origin_m)
		owner_company_id=str(snapshot.owner_company_id)
		_site_needs_home=true
		save_path="user://custom_ports/imported-%s.json"%str(snapshot.id).sha256_text().left(16)
		home_local=Vector3.UP*2
		for placement in snapshot.placements:
			if str(catalog.get(str(placement.asset_id),{}).get("kind",""))=="platform":
				home_local=CustomPortCatalog.vector3(placement.position_m)+Vector3.UP*.1;break
	else:
		var plot:=plot_index.plot_at(Vector2(site.x,site.z+40))
		var bounds:=ChartPlotLayer.plot_rect(plot)
		var plots: Array=[{"id":str(plot.id),"rect_m":[bounds.position.x-site.x,bounds.position.y-site.z,bounds.size.x,bounds.size.y],"owner_company_id":owner_company_id}]
		if example_kind==2 and not OS.get_cmdline_user_args().has("--empty-custom-port"):
			snapshot=STARTER_EXAMPLE.build(site,plots,world_identity,_support_seabed)
			owner_company_id=str(snapshot.owner_company_id)
			save_path="user://custom_ports/littlehaven-starter.json"
			_site_needs_home=true
		elif example_kind==1 and not OS.get_cmdline_user_args().has("--empty-custom-port"):
			snapshot=FISHING_EXAMPLE.build(site,plots,world_identity,_support_seabed)
			owner_company_id=str(snapshot.owner_company_id)
			save_path="user://custom_ports/skjaervik-fishing-pier.json"
			_site_needs_home=true
		else:snapshot=CustomPortExample.build(site,plots,world_identity,0,_support_seabed)
		CustomPortExample.survey(snapshot,_water_seabed,WaveSurface.WATER_LEVEL)
		if OS.get_cmdline_user_args().has("--empty-custom-port"):
			_site_needs_home=true
			snapshot.id="my-harbour"
			snapshot.name="My harbour"
			snapshot.placements=[]
			snapshot.stores=[]
			snapshot.vessels=[]
			snapshot.reservations=[]
			save_path="user://custom_ports/my-harbour.json"
			home_local=Vector3(-4,2,84)
	simulated_accounts={owner_company_id:{"balance_nok":maxf(0,WORKSHOP_BUDGET_NOK-PLOT_PRICE_NOK*(snapshot.plots.size()-1))}}
	state=CustomPortState.from_dict(snapshot,world_identity,catalog)
	if not state.validation_errors.is_empty():
		for error in state.validation_errors: push_error(error)
		get_tree().quit(1); return
	if example_kind==1 and input_path.is_empty() and not OS.get_cmdline_user_args().has("--empty-custom-port"):
		var berths:=state.derived_berths()
		var arrival: Dictionary=state.apply({"command_id":"fishing-example-arrival","expected_revision":state.revision(),"actor_company_id":"company-visitor","kind":"dock",
			"payload":{"vessel_id":"nordlys","berth_id":str(berths[0].id) if not berths.is_empty() else ""}})
		if not arrival.ok:push_error("Fishing example arrival rejected: "+str(arrival));get_tree().quit(1);return
	if _site_needs_home:
		var initial_home:=_find_home()
		home_local=initial_home.local if initial_home.ok else Vector3(0,10,0)
	if example_kind==2 and input_path.is_empty() and not OS.get_cmdline_user_args().has("--empty-custom-port"):
		var arrival:Dictionary=STARTER_EXAMPLE.arrive(state)
		if not arrival.ok:push_error("Starter arrival failed: "+str(arrival));get_tree().quit(1);return
	var renderer:=WorldRenderer.new()
	renderer.enable_ocean_system=RenderingServer.get_rendering_device()!=null
	renderer.enable_ssil=false
	renderer.enable_weather_post_fx=false
	renderer.enable_volumetric_fog=false
	add_child(renderer)
	presenter=CustomPortPresenter.new()
	add_child(presenter)
	transfers=preload("res://scripts/port/building/custom_port_transfer_presenter.gd").new()
	add_child(transfers)
	transfers.bind(presenter)
	transfers.phase_changed.connect(func(label:String)->void:
		if feedback!=null: feedback.text=label)
	transfers.presentation_failed.connect(func(reason:String)->void:
		if feedback!=null: feedback.text=reason)
	presenter.operator_selected.connect(_open_operator)
	transfers.present(state.to_dict(),state.derived_berths())
	placement_picker.configure(presenter)
	player=PLAYER.instantiate()
	player.position=site+home_local
	add_child(player)
	vessel_session=CustomPortVesselSession.new()
	add_child(vessel_session)
	vessel_session.configure(state,presenter,player,transfers)
	vessel_session.state_changed.connect(_on_state_changed)
	vessel_session.feedback_changed.connect(func(message:String)->void:
		_sailing_feedback_until=Time.get_ticks_msec()+3500
		if feedback!=null:feedback.text=message)
	_pause_player(true)
	add_child(camera)
	camera.minimum_y=site.y+1
	camera.far=12000
	camera.fov=55
	camera.position=site+Vector3(-145,70,-60)
	camera.look_at(site+Vector3(-25,3,28))
	if example_kind==1:
		camera.position=site+Vector3(-36,30,-35)
		camera.look_at(site+Vector3(0,2,16))
	elif example_kind==2:
		camera.position=site+Vector3(-38,28,13)
		camera.look_at(site+Vector3(0,1,49))
	camera.current=true
	terrain=WorldTerrainStreamer.new()
	# DistantForest is a whole-world silhouette. Keep the coarse terrain rings
	# beneath it; otherwise the review shows trees floating beyond the near ring.
	terrain.visual_radius_m=12000
	terrain.collision_radius_m=800
	terrain.build_budget_ms=8
	terrain.max_jobs_per_frame=2
	terrain.begin_boot_priority(site)
	add_child(terrain)
	terrain.set_custom_port_earthworks([EARTHWORKS.project(state.to_dict(),catalog,state.construction_edges())])
	terrain.configure(layout)
	forest=WorldForestStreamer.new()
	forest.name="WorkshopForest"
	forest.boot_focus=site
	add_child(forest)
	forest.configure(layout)
	forest.set_custom_port_exclusions("custom-port-workshop",EARTHWORKS.forest_exclusions(EARTHWORKS.project(state.to_dict(),catalog,state.construction_edges())))
	overlays=Node3D.new()
	add_child(overlays)
	add_child(build_guides)
	build_guides.hide()
	_build_ui()
	_connect_editor()
	_update_overlays()
	var deadline:=Time.get_ticks_msec()+30000
	while not terrain.is_ready_around(site,220) and Time.get_ticks_msec()<deadline: await get_tree().process_frame
	terrain.end_boot_priority()
	forest.boot_focus=Vector3(INF,INF,INF)
	ready_for_review=true
	_set_cursor(true)
	feedback.text="Tab · Fly / choose   R · Rotate   LMB · Place   RMB · Remove   Ctrl+Z · Undo   Esc · Walk"
	print("CUSTOM_PORT_WORKSHOP_READY placements=",state.to_dict().placements.size()," berths=",state.derived_berths().size())
	if _capture_mode: call_deferred("_review")
	elif OS.get_cmdline_user_args().has("--empty-custom-port"):call_deferred("open_new_harbour")
	elif example_kind==2 and input_path.is_empty():call_deferred("open_start_choices")

func _water_seabed(at: Vector2) -> float:
	var continuous:=WorldTerrainStreamer.sample_render_terrain_height(layout,at)
	var triangulated:=WorldForestStreamer.sample_root_height(layout,at,[],_terrain_height_cache)
	# A shallower visual surface must not be advertised as deeper navigable water.
	return maxf(continuous,triangulated)

func _support_seabed(at: Vector2) -> float:
	var continuous:=WorldTerrainStreamer.sample_render_terrain_height(layout,at)
	var triangulated:=WorldForestStreamer.sample_root_height(layout,at,[],_terrain_height_cache)
	# Foundations reach the lower surface rather than stopping above either one.
	return minf(continuous,triangulated)

func _foundation_ground_height(at: Vector2) -> float:
	# Original near-terrain triangles, excluding the port's own earthworks.
	return WorldForestStreamer.sample_root_height(layout,at,[],_terrain_height_cache)

func _connect_editor() -> void:
	var path:="res://scripts/port/building/custom_port_editor.gd"
	if not ResourceLoader.exists(path): return
	editor=load(path).new()
	editor.call("configure",state,catalog,owner_company_id)
	editor.call("configure_terrain",_foundation_ground_height,WorldTerrainStreamer.DEFAULT_LOD_STEPS[0])

